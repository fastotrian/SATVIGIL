          ],
          "path": [
            "api",
            "v1",
            "maritime",
            "vessels",
            "{vessel_id}",
            "track"
          ]
        },
        "description": "Return historical AIS track for a vessel as a GeoJSON FeatureCollection.\nContains:\n  - A LineString of the full route\n  - Individual Point features for each observation (with presence_hours, timestamps)\n  - Highlighted dark gap event if present (47-minute blackout segment in red)\n\nSources:\n  - 419082341 / MT GUJARAT PRIDE: Forensic Bombay High passage across backtracked spill origin\n  - 419001845 / MV KUTCH EXPLORER: GFW presence track in Gulf of Kutch July 2026"
      }
