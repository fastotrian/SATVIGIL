# ─── SATVIGIL Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your real values before running docker-compose

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
SECRET_KEY=changeme_generate_a_random_64char_string
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=satvigil
POSTGRES_USER=satvigil_user
POSTGRES_PASSWORD=satvigil_pass

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── NASA FIRMS ────────────────────────────────────────────────────────────────
# Get free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# ── AIS / Vessel Tracking ────────────────────────────────────────────────────
# AISHub (free): https://www.aishub.net/
AISHUB_USERNAME=your_aishub_username
AISHUB_PASSWORD=your_aishub_password

# Global Fishing Watch (free API): https://globalfishingwatch.org/
GFW_API_TOKEN=your_gfw_token_here
GFW_AIS_REGION=gulf_of_kutch
GFW_AIS_LOOKBACK_DAYS=2
GFW_AIS_MAX_VESSELS=8

# ── Copernicus / Sentinel ────────────────────────────────────────────────────
# Free account: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret

# ── Mapbox ───────────────────────────────────────────────────────────────────
# Free tier: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# ── VIIRS Nightfire ──────────────────────────────────────────────────────────
# Free download: https://eogdata.mines.edu/products/vnf/
# No API key required — data downloaded via wget/curl

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
